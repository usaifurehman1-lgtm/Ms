<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#101820">
    <title>Haye - Audio & Video Call</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            width: 100%;
            height: 100dvh;
            overflow: hidden;
            background: #101820;
            color: white;
            font-family: Arial, sans-serif;
        }

        .app {
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            position: relative;
            background: #101820;
        }

        .header {
            height: 60px;
            padding: 0 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #17232d;
            flex-shrink: 0;
        }

        .logo {
            font-size: 23px;
            font-weight: bold;
            color: #25d366;
        }

        .status {
            font-size: 12px;
            color: #b7c5ce;
        }

        .call-screen {
            flex: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #202d38;
        }

        .remote-video {
            width: 100%;
            height: 100%;
            object-fit: cover;
            background: #202d38;
        }

        .profile {
            position: absolute;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            z-index: 1;
        }

        .avatar {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: #344955;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 45px;
            border: 3px solid #25d366;
        }

        .profile h2 {
            font-size: 22px;
        }

        .call-time {
            color: #cbd5dc;
            font-size: 14px;
        }

        .local-video {
            position: absolute;
            width: 115px;
            height: 165px;
            right: 15px;
            top: 15px;
            object-fit: cover;
            border-radius: 14px;
            background: #111;
            border: 2px solid white;
            z-index: 2;
            display: none;
        }

        .bottom-panel {
            padding: 20px 12px 28px;
            background: #17232d;
            flex-shrink: 0;
        }

        .controls {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 17px;
            flex-wrap: wrap;
        }

        .control {
            width: 55px;
            height: 55px;
            border: none;
            border-radius: 50%;
            background: #344955;
            color: white;
            font-size: 21px;
            cursor: pointer;
        }

        .control.active {
            background: #25d366;
            color: #101820;
        }

        .control.end {
            background: #e53935;
            width: 65px;
            height: 65px;
        }

        .call-options {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 20px;
        }

        .call-button {
            border: none;
            border-radius: 25px;
            padding: 13px 22px;
            color: white;
            background: #25d366;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
        }

        .call-button.video {
            background: #2878d0;
        }

        .incoming {
            position: absolute;
            inset: 0;
            z-index: 10;
            background: rgba(10, 20, 28, 0.97);
            display: none;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 22px;
        }

        .incoming h2 {
            font-size: 25px;
        }

        .incoming p {
            color: #b7c5ce;
        }

        .incoming-buttons {
            display: flex;
            gap: 30px;
            margin-top: 20px;
        }

        .incoming-buttons button {
            width: 65px;
            height: 65px;
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 25px;
        }

        .accept {
            background: #25d366;
        }

        .reject {
            background: #e53935;
        }

        @media (max-width: 360px) {
            .controls {
                gap: 10px;
            }

            .control {
                width: 48px;
                height: 48px;
            }

            .control.end {
                width: 58px;
                height: 58px;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <header class="header">
        <div class="logo">Haye</div>
        <div class="status" id="status">Ready</div>
    </header>

    <main class="call-screen">

        <video
            id="remoteVideo"
            class="remote-video"
            autoplay
            playsinline>
        </video>

        <div class="profile" id="profile">
            <div class="avatar">H</div>
            <h2 id="contactName">Haye User</h2>
            <div class="call-time" id="callTime">Waiting for call</div>
        </div>

        <video
            id="localVideo"
            class="local-video"
            autoplay
            muted
            playsinline>
        </video>

    </main>

    <section class="bottom-panel">

        <div class="call-options" id="callOptions">
            <button class="call-button" onclick="startAudioCall()">
                📞 Audio Call
            </button>

            <button class="call-button video" onclick="startVideoCall()">
                📹 Video Call
            </button>
        </div>

        <div class="controls">

            <button class="control" id="muteButton" onclick="toggleMute()">
                🎤
            </button>

            <button class="control" id="speakerButton" onclick="toggleSpeaker()">
                🔊
            </button>

            <button class="control end" onclick="endCall()">
                📞
            </button>

            <button class="control" id="cameraButton" onclick="toggleCamera()">
                📷
            </button>

            <button class="control" onclick="switchCamera()">
                🔄
            </button>

            <button class="control" onclick="toggleFullscreen()">
                ⛶
            </button>

        </div>

    </section>

    <div class="incoming" id="incomingScreen">
        <div class="avatar">H</div>
        <h2>Incoming Call</h2>
        <p id="incomingType">Audio call</p>

        <div class="incoming-buttons">
            <button class="accept" onclick="acceptCall()">📞</button>
            <button class="reject" onclick="rejectCall()">✖</button>
        </div>
    </div>

</div>

<script>
    const statusElement = document.getElementById("status");
    const callTimeElement = document.getElementById("callTime");
    const incomingScreen = document.getElementById("incomingScreen");
    const incomingType = document.getElementById("incomingType");
    const callOptions = document.getElementById("callOptions");
    const localVideo = document.getElementById("localVideo");
    const profile = document.getElementById("profile");

    let callStarted = false;
    let isMuted = false;
    let isSpeakerOn = false;
    let isCameraOn = true;
    let isVideoCall = false;
    let seconds = 0;
    let timer = null;

    function getBridge() {
        if (window.AndroidBridge) {
            return window.AndroidBridge;
        }

        if (window.HayeCallBridge) {
            return window.HayeCallBridge;
        }

        return null;
    }

    function callNative(method, ...args) {
        const bridge = getBridge();

        if (bridge && typeof bridge[method] === "function") {
            bridge[method](...args);
            return true;
        }

        statusElement.textContent = "Android bridge unavailable";
        return false;
    }

    function startAudioCall() {
        isVideoCall = false;
        callNative("startAudioCall");
        statusElement.textContent = "Starting audio call...";
        callOptions.style.display = "none";
    }

    function startVideoCall() {
        isVideoCall = true;
        localVideo.style.display = "block";
        callNative("startVideoCall");
        statusElement.textContent = "Starting video call...";
        callOptions.style.display = "none";
    }

    function acceptCall() {
        incomingScreen.style.display = "none";
        callNative("acceptCall");
        statusElement.textContent = "Connecting...";
    }

    function rejectCall() {
        incomingScreen.style.display = "none";
        callNative("rejectCall");
        resetCall();
    }

    function endCall() {
        callNative("endCall");
        resetCall();
    }

    function toggleMute() {
        isMuted = !isMuted;

        document.getElementById("muteButton").classList.toggle("active", isMuted);

        callNative("setMuted", isMuted);
    }

    function toggleSpeaker() {
        isSpeakerOn = !isSpeakerOn;

        document.getElementById("speakerButton").classList.toggle("active", isSpeakerOn);

        callNative("setSpeakerEnabled", isSpeakerOn);
    }

    function toggleCamera() {
        isCameraOn = !isCameraOn;

        document.getElementById("cameraButton").classList.toggle("active", !isCameraOn);

        callNative("setCameraEnabled", isCameraOn);
    }

    function switchCamera() {
        callNative("switchCamera");
    }

    async function toggleFullscreen() {
        try {
            if (!document.fullscreenElement) {
                await document.documentElement.requestFullscreen();
            } else {
                await document.exitFullscreen();
            }
        } catch (error) {
            statusElement.textContent = "Fullscreen unavailable";
        }
    }

    function startTimer() {
        clearInterval(timer);
        seconds = 0;

        timer = setInterval(() => {
            seconds++;

            const minutes = Math.floor(seconds / 60);
            const remainingSeconds = seconds % 60;

            callTimeElement.textContent =
                String(minutes).padStart(2, "0") + ":" +
                String(remainingSeconds).padStart(2, "0");

        }, 1000);
    }

    function resetCall() {
        clearInterval(timer);

        callStarted = false;
        seconds = 0;

        callTimeElement.textContent = "Call ended";
        statusElement.textContent = "Ready";

        localVideo.style.display = "none";
        callOptions.style.display = "flex";
        profile.style.display = "flex";
        incomingScreen.style.display = "none";

        isMuted = false;
        isSpeakerOn = false;
        isCameraOn = true;
        isVideoCall = false;

        document.getElementById("muteButton").classList.remove("active");
        document.getElementById("speakerButton").classList.remove("active");
        document.getElementById("cameraButton").classList.remove("active");
    }

    /*
       These functions can be called by Android JavaScript bridge.
    */

    window.onIncomingCall = function(video) {
        isVideoCall = Boolean(video);

        incomingType.textContent = isVideoCall ? "Video call" : "Audio call";
        incomingScreen.style.display = "flex";
    };

    window.onCallConnected = function() {
        callStarted = true;

        statusElement.textContent = "Connected";
        callOptions.style.display = "none";

        if (isVideoCall) {
            localVideo.style.display = "block";
        }

        startTimer();
    };

    window.onCallEnded = function() {
        resetCall();
    };

    window.onCallError = function(message) {
        statusElement.textContent = message || "Call error";
    };

    window.onCallStatus = function(message) {
        statusElement.textContent = message;
    };

    window.onRemoteVideo = function() {
        profile.style.display = "none";
    };

    window.addEventListener("load", function() {
        statusElement.textContent = "Ready";
    });
</script>

</body>
</html>
